---
import type { Series } from "../lib/photos";

interface Props {
  series: Series[];
}

const { series } = Astro.props;
---

<div class="about" aria-hidden="true" role="dialog" aria-label="About">
  <div class="about__inner">
    <p class="about__desc">
      <!-- TODO: write your own bio -->
      Photographs by Antoine Pouligny, grouped in collections. A quiet place to look
      at them, one at a time.
    </p>

    <div class="about__list">
      <p class="about__section-lbl">Prints</p>
      <p>
        Interested in a print?
        <a href="mailto:a.pouligny@gmail.com" class="about__link">a.pouligny@gmail.com</a>
      </p>
    </div>

    <div class="about__list">
      <p class="about__section-lbl">Elsewhere</p>
      <p>
        <a
          href="https://www.pantoine.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="about__link"
        >
          Portfolio, pantoine.com &nearr;
        </a>
      </p>
      <p>
        <a
          href="https://unsplash.com/@gimmick"
          target="_blank"
          rel="noopener noreferrer"
          class="about__link"
        >
          Unsplash profile, @gimmick &nearr;
        </a>
      </p>
    </div>

    <div class="about__list">
      <p class="about__section-lbl">Navigate</p>
      <p>&larr; &rarr; to browse, Esc to close, I to switch between index and collections.</p>
    </div>

    <!-- Every photo as its colour, in the collections' order; each opens its photo -->
    <div class="about__palette-wrap">
      <p class="about__section-lbl">Palette</p>
      <div class="about__palette">
        {
          series.flatMap((s) =>
            s.photos.map((photo) => (
              <a
                href={`#${s.slug}/${photo.indexInSeries + 1}`}
                class="about__swatch"
                style={`background: ${photo.color};`}
                title={`${s.title}, ${photo.indexInSeries + 1}`}
                aria-label={`${s.title}, image ${photo.indexInSeries + 1}`}
              />
            )),
          )
        }
      </div>
    </div>
  </div>
</div>
